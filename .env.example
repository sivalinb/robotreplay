# Server-side only. Never put keys in JavaScript, prompts, Git, or telemetry.
RR_DATA_DIR=.data
RR_PROVIDER=local
RR_MODEL=
RR_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
RR_MODEL_API_KEY=
RR_MODEL_TIMEOUT=8
RR_INPUT_USD_PER_MILLION=0
RR_OUTPUT_USD_PER_MILLION=0
RR_MODEL_BUDGET_USD=0
RR_GPU_HOURLY_RATE=0
RR_CONTEXT_LIMIT=8192
RR_OUTPUT_TOKENS=256
# Optional remote embedding endpoint, with a separately configured model.
RR_EMBEDDING_MODEL=
RR_EMBEDDING_BASE_URL=
RR_EMBEDDING_API_KEY=
RR_EMBEDDING_USD_PER_MILLION=0
RR_NEMO_ENABLED=false
# Set secure cookies and explicit hostname before use behind a TLS reverse proxy.
RR_SECURE_COOKIES=false
RR_ALLOWED_HOSTS=localhost,127.0.0.1,app,testserver
# OTLP/HTTP traces; empty means local SQLite trace export only.
RR_OTLP_ENDPOINT=
